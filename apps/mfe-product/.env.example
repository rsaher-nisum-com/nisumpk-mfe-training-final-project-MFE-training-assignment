# Where this MFE's dev server / build output is served from - used as webpack's publicPath
# so the gateway (and this app's own remoteEntry.js) can resolve chunks correctly.
PUBLIC_PATH=http://localhost:3001/

# Backend API base URL this MFE calls directly (products list/detail).
API_URL=http://localhost:4000

# Feature flag (Bonus): gates the "Recommended products" section.
ENABLE_RECOMMENDATIONS=true
